{
  "name": "homebox-clipper",
  "description": "Import your online purchases into your HomeBox inventory.",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test:build": "vitest run --config vitest.build.config.ts",
    "check:config": "bun scripts/check-config.ts",
    "ci": "bun run check:config && bun run typecheck && bun run lint && bun run test && bun run build && bun run test:build",
    "setup": "sh scripts/setup.sh",
    "homebox:up": "docker compose up -d",
    "homebox:down": "docker compose down",
    "homebox:logs": "docker compose logs -f homebox",
    "icons": "sh scripts/gen-icons.sh",
    "release:notes": "bun scripts/release-notes.ts",
    "wiki:publish": "sh scripts/publish-wiki.sh"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@wxt-dev/i18n": "^0.2.8",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wxt": "^0.21.4"
  },
  "packageManager": "bun@1.4.4"
}
