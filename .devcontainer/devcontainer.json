{
  "name": "homebox-clipper",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-bookworm",
  "features": {
    // Container-specific Docker daemon: `bun run homebox:up` starts the HomeBox instance there.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // Local HomeBox, opened from the host browser at http://localhost:3100
  "forwardPorts": [3100],
  "portsAttributes": {
    "3100": { "label": "HomeBox (dev)", "onAutoForward": "notify" }
  },
  "postCreateCommand": "sh .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "EditorConfig.EditorConfig",
        "oven.bun-vscode",
        "fill-labs.dependi",
        "usernamehw.errorlens",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint",
        "christian-kohler.npm-intellisense",
        "piotrpalarz.vscode-gitignore-generator",
        "steoates.autoimport",
        "Blodwynn.featurehighlight"
      ]
    }
  }
}
