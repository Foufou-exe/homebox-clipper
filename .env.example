# Copier en .env (ignoré par git) : cp .env.example .env
# Puis générer le pepper : sed -i "s|^HBOX_AUTH_API_KEY_PEPPER=.*|HBOX_AUTH_API_KEY_PEPPER=$(openssl rand -base64 48)|" .env

# Secret serveur HomeBox (≥ 32 octets). Ne jamais le commiter. Ne pas le changer après coup :
# toutes les clés API existantes deviendraient invalides.
HBOX_AUTH_API_KEY_PEPPER=

# Optionnel
# HOMEBOX_VERSION=v0.27.0
# HOMEBOX_PORT=3100
# TZ=Europe/Paris
