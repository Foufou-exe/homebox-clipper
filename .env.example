# Copy to .env (ignored by git) : cp .env.example .env
# Then generate the pepper : sed -i "s|^HBOX_AUTH_API_KEY_PEPPER=.*|HBOX_AUTH_API_KEY_PEPPER=$(openssl rand -base64 48)|" .env

# HomeBox server secret (>= 32 bytes). Never commit it. Do not change it afterwards:
# all existing API keys would become invalid.
HBOX_AUTH_API_KEY_PEPPER=

# Optionnel
# HOMEBOX_VERSION=v0.27.0
# HOMEBOX_PORT=3100
# TZ=Europe/Paris
